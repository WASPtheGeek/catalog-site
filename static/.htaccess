# ====================================================================
# 1. STRATEGIC REDIRECTS AND SEO
# ====================================================================
RewriteEngine On
RewriteBase /

# Redirect specific old product and section pages to the new layout
RewriteRule ^html/lv/products/sam4s_NR-320B\.html$ /lv/products/ [R=301,L]
RewriteRule ^html/lv/sections/boxs\.html$ /lv/products/ [R=301,L]
RewriteRule ^html/en/nav/about_us\.html$ /en/about/ [R=301,L]

# Global rule for the legacy /html/ folder (redirects everything else to homepage)
RewriteRule ^html/(.*)$ / [R=301,L]

# Custom 404 error page (internal redirect to preserve SEO status codes)
ErrorDocument 404 /lv/


# ====================================================================
# 2. CACHING AND EXPIRATION TIMES (BROWSER CACHE)
# ====================================================================
<IfModule mod_expires.c>
  ExpiresActive On

  ## CSS and JS (1 week)
  ExpiresByType text/css "now plus 1 week"
  ExpiresByType application/javascript "now plus 1 week"
  ExpiresByType application/x-javascript "now plus 1 week"

  ## Images and Icons (1 month)
  ExpiresByType image/bmp "now plus 1 month"
  ExpiresByType image/gif "now plus 1 month"
  ExpiresByType image/jpeg "now plus 1 month"
  ExpiresByType image/webp "now plus 1 month"
  ExpiresByType image/png "now plus 1 month"
  ExpiresByType image/svg+xml "now plus 1 month"
  ExpiresByType image/x-icon "now plus 1 month"
  ExpiresByType image/ico "now plus 1 month"
  ExpiresByType image/icon "now plus 1 month"

  ## Fonts (1 month)
  ExpiresByType application/x-font-ttf "now plus 1 month"
  ExpiresByType application/x-font-opentype "now plus 1 month"
  ExpiresByType application/x-font-woff "now plus 1 month"
  ExpiresByType font/woff2 "now plus 1 month"
</IfModule>

# Hard caching for static resources (1 year, immutable)
<filesMatch ".(css|jpg|jpeg|png|webp|gif|js|ico|woff|woff2|eot|ttf)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</filesMatch>


# ====================================================================
# 3. RESOURCE COMPRESSION (GZIP / DEFLATE)
# ====================================================================

# Modern Apache compression module (mod_filter/mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Fallback compression by file extension
<FilesMatch ".(html|css|js|ico|xml)$">
  SetOutputFilter DEFLATE
</FilesMatch>

# Notify proxy servers about compressed content variants
<IfModule mod_headers.c>
  <FilesMatch ".(js|css|xml|gz|html)$">
    Header append Vary: Accept-Encoding
  </FilesMatch>
</IfModule>